<section class="promotion-section" style="text-align : {{ section.settings.title_alignment  }}">
  <h2>{{ section.settings.title }}</h2>
</section>

<div style="display: flex; justify-content: center; gap: 20px; padding: 20px;">
  {% for block in section.blocks %}
  {% if block.type == "promotion"%}
   <div style="display: flex; flex-direction: column;">
     <h3 style="text-align:center; margin: 10px;">{{ block.settings.promotion }}</h3>
    {{  block.settings.image | image_url: width: 500 | image_tag }}
   </div>
  {% endif %}
{% endfor %}

</div>



{% schema %}
{
  "name": "Promotions Group",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our Latest Promotions"
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    
  ],
  "blocks":[
    {
        "type": "promotion",
        "name": "promotion",
        "settings":[{
        "type": "text",
    "id": "promotion",
    "label": "Title"
}
            ,{
        "type": "image_picker",
        "id":"image",
        "label": "Image"
    }]
    }
],
  "presets": [
    {
      "name": "Promotions Group",
      "blocks": [
        {
        "type": "promotion",
    },{
        "type": "promotion",
    }
      ]
    }
  ]
}
{% endschema %}
