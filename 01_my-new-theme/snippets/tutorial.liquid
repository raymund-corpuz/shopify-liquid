{% assign myHtmlText = "<p style='color: red'>Hello</p>" %}
{{ myHtmlText | strip_html}}

{% assign myLongString = 'This is some very long text that will be tripped' %}
<p>{{ myLongString | truncatewords: 3}}</p>

{% assign myMultilineText = "This is the first line
   This is the second line
   This is the third line" |newline_to_br %}

   <p>{{ myMultilineText }}</p>

   <br>
   {% assign myText = "Hello some extra text some extra text" %}
   <p>{{ myText | replace: 'text', 'string' }}</p>

   {% comment %}
   // ======== FILTER ARRAY ============ // 
   {% endcomment %}
    {% assign myNumbers = '1,2,3,4' | split: ',' %}

    {% for num in myNumbers %}
      <p>{{ num }}</p>
    {% endfor %}

    {%  assign products =  collection.products %}
    {% assign productTitles =  products | map:'title' %}

    {% for prodTitle in productTitles %}
      <p>{{ prodTitle }}</p>
    {% endfor %}

    {% assign priceSortedItems =  products | sort: 'price' %}
    {% for prod in priceSortedItems %}
      <p>{{ prod.title }} - {{ prod.price | money }}</p>
    {% endfor %}

    {% assign allPrices =  products |map: 'price' | sort %}
    {% for price in allPrices %}
      <p> Price : {{ price | money}}</p>
    {% endfor %}

    {%  assign sumOfPrices =  allPrices | sum %}
    <p>Total of all items: {{ sumOfPrices |money}}</p>

    <br>
    <p>{{ collection.description | default: 'This is a default description' }}</p>

    <p>{{ 'This is some text with more text' | highlight: 'text' }}</p>

    <style>
      .highlight{
      background:yellow;}
    </style>

    <br>
    <p>Copyright {{ 'now' | date: '%Y-%m-%d' }}</p>

    {{ collection.products.first.featured_image | image_url: width: 200, height:200 | image_tag  }}

    {% liquid
      
      assign myUltVariable = 10

      for product in collection.products
      echo '<p>' | append: product.title | append: '</p>'
