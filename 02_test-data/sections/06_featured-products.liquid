

<section class="w-full bg-gray-50 p-4">

  <h2 class="text-gray-800 text-center text-3xl  font-bold">{{ section.settings.feature-title }}</h2>

  {%  if  section.settings.featured_product%}
    {% assign product = all_products[section.settings.featured_product] %}
    <div class="bg-white p-8 rounded-2xl shadow-md flex flex-col sm:flex-row justify-center items-center gap-4"   >
       <img
          src="{{ product.featured_image | img_url: '500x' }}"
          alt="{{ product.title }}"
          class="w-full sm:w-1/3 rounded-xl"
        >
     
      <div class="text-left ">
         <h3 class="text-2xl font-semibold mb-2">{{product.title}}</h3>
         <p class="text-gray-600 mb-4">{{ product.description | truncate: 100 }}</p>
         <p class="text-xl font-bold mb-6">{{ product.price |money }}</p>

         {% form 'product', product %}
          <button type="submit" name="add" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">Add to Cart</button>
         {% endform %}
      </div>

    </div>

  {% endif %}

</section>



{% schema %}

{
  "name": "Featured Product",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "feature-title",
      "label": "Section Title",
      "default": "Feature Product"
    },
    {
      "type": "product",
      "id":"featured_product",
      "label": "Select Product",
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "category": "Product"
    }
  ]
}
{% endschema %}